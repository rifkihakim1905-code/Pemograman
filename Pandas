        "import re\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "\n",
        "# #P1 - Running Pandas dan NumPy serta Menampilkan Array 1-Dimensi[cite: 1]\n",
        "print(\"--- #P1 ---\")\n",
        "ds = pd.Series([2, 4, 6, 8, 10])\n",
        "print(ds)\n",
        "\n",
        "\n",
        "# #P2 - Membuat Series & Mengatur Indeks[cite: 1]\n",
        "print(\"\\n--- #P2 ---\")\n",
        "data = pd.Series(['a', 'b', 'c'])  # !sS\n",
        "np1 = np.array(['x', 'y', 'z'])\n",
        "data_np = pd.Series(np1)\n",
        "\n",
        "\n",
        "print(data)\n",
        "print(data_np)\n",
        "\n",
        "\n",
        "data_np = pd.Series(np1, index=[2, 3, 4])\n",
        "print(data_np)\n",
        "\n",
        "\n",
        "# #P3 - Contoh Operasi Aritmatika pada Series[cite: 1]\n",
        "print(\"\\n--- #P3 ---\")\n",
        "ds1 = pd.Series([2, 4, 6, 8, 10])\n",
        "ds2 = pd.Series([1, 3, 5, 7, 9])\n",
        "\n",
        "\n",
        "dsa = ds1 + ds2  # operasi jumlah\n",
        "dsb = ds1 - ds2\n",
        "dsc = ds1 * ds2\n",
        "dsd = ds1 / ds2\n",
        "\n",
        "\n",
        "print(dsa)\n",
        "print(dsb)\n",
        "print(dsc)\n",
        "print(dsd)\n",
        "\n",
        "\n",
        "# #P4 - Konversi Pandas Series ke Python List[cite: 1]\n",
        "print(\"\\n--- #P4 ---\")\n",
        "ds = pd.Series([2, 4, 6, 8, 10])\n",
        "print(\"Pandas Series dan type\")\n",
        "print(ds)\n",
        "print(type(ds))\n",
        "\n",
